{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "apara-talent",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build api-gateway",
    "build:all": "nest build api-gateway && nest build auth-service && nest build user-service && nest build resume-builder-service && nest build chat-service && nest build job-service && nest build notification-service",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "npm run start:production",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "build:api": "nest build api-gateway",
    "prestart:production": "npm run build",
    "start:production": "cross-env NODE_ENV=production node --enable-source-maps dist/apps/api-gateway/main.js",
    "start:prod": "npm run start:production",
    "start:prod:api": "cross-env NODE_ENV=production node --enable-source-maps dist/apps/api-gateway/main.js",
    "lint": "npm run lint:check -- --fix",
    "lint:check": "eslint \"apps/**/*.ts\" \"libs/**/*.ts\" \"test/**/*.ts\" \"migrations/**/*.ts\" \"scripts/**/*.ts\" \"data-source.ts\"",
    "test": "cross-env NODE_ENV=test jest",
    "test:ci": "cross-env NODE_ENV=test jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "cross-env NODE_ENV=test jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "node test/e2e/run-e2e.mjs",
    "test:e2e:spec": "jest --config ./test/e2e/jest-e2e.json --runInBand",
    "test:load": "node scripts/load/smoke-load.mjs",
    "test:load:check": "cross-env LOAD_DRY_RUN=1 node scripts/load/smoke-load.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "e2e:infra:up": "docker compose -f test/e2e/docker-compose.e2e.yml -p apsara-talent-e2e up -d --wait",
    "e2e:infra:down": "docker compose -f test/e2e/docker-compose.e2e.yml -p apsara-talent-e2e down -v --remove-orphans",
    "start:dev:api": "nest start api-gateway --watch",
    "start:dev:auth": "nest start auth-service --watch",
    "start:dev:users": "nest start user-service --watch",
    "start:dev:resume": "nest start resume-builder-service --watch",
    "start:dev:chat": "nest start chat-service --watch",
    "start:dev:job": "nest start job-service --watch",
    "start:dev:notification": "nest start notification-service --watch",
    "check:env": "ts-node -r tsconfig-paths/register scripts/ci/check-env.ts",
    "check:env:all": "npm run check:env -- .env .env.development .env.production",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d data-source.ts",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "migration:create": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:create",
    "migration:baseline": "ts-node -r tsconfig-paths/register scripts/db/baseline-migrations.ts",
    "db:backup": "./scripts/db/backup-db.sh",
    "db:restore-point": "node --env-file-if-exists=.env scripts/ci/create-restore-point.mjs",
    "storage:migrate": "ts-node -r tsconfig-paths/register scripts/db/migrate-storage-to-s3.ts",
    "seed": "ts-node -r tsconfig-paths/register scripts/db/seed.ts",
    "backfill:embeddings": "ts-node -r tsconfig-paths/register scripts/db/backfill-embeddings.ts",
    "start:api": "nest start api-gateway",
    "start:auth": "nest start auth-service",
    "start:users": "nest start user-service",
    "start:resume": "nest start resume-builder-service",
    "start:chat": "nest start chat-service",
    "start:job": "nest start job-service",
    "start:notification": "nest start notification-service",
    "typecheck:strict": "node scripts/ci/strict-null-ratchet.mjs",
    "sentry:sourcemaps": "node scripts/upload-sourcemaps.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@keyv/redis": "^5.1.6",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.28",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/microservices": "^11.1.28",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.4",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.3",
    "@nestjs/websockets": "^11.1.28",
    "@sentry/nestjs": "^10.69.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/multer": "^1.4.12",
    "@types/nodemailer": "^6.4.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-linkedin-oauth2": "^1.5.6",
    "@types/pdf-parse": "^1.1.5",
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.8.2",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "mustache": "^4.2.0",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^9.0.3",
    "openai": "^4.83.0",
    "otplib": "^13.4.1",
    "passport": "^0.7.0",
    "passport-auth0": "^1.4.4",
    "passport-facebook": "^3.0.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-linkedin-oauth2": "^2.0.0",
    "passport-local": "^1.0.0",
    "pdf-parse": "^1.1.4",
    "pg": "^8.22.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "puppeteer": "^24.2.0",
    "redis": "^5.5.5",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.6.1",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@sentry/cli": "^3.6.2",
    "@types/cache-manager": "^4.0.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^29.5.14",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.3.1",
    "@types/passport": "^1.0.17",
    "@types/passport-auth0": "^1.0.9",
    "@types/passport-facebook": "^3.0.3",
    "@types/passport-github2": "^1.2.9",
    "@types/socket.io": "^3.0.2",
    "@types/supertest": "^6.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jest": "^29.5.0",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^6.0.1"
  },
  "optionalDependencies": {
    "@img/sharp-linuxmusl-x64": "0.35.3"
  },
  "overrides": {
    "basic-ftp": "5.3.1",
    "brace-expansion": "5.0.9",
    "gaxios": "7.3.0",
    "google-gax": "5.0.8",
    "js-yaml": "5.2.3",
    "multer": "$multer",
    "protobufjs": "7.6.5",
    "fast-xml-parser": "5.10.1",
    "rimraf": "6.1.3",
    "tar": "7.5.22",
    "uuid": "11.1.1",
    "websocket-driver": "0.7.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "clover",
      "json",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 78,
        "functions": 82,
        "lines": 89,
        "statements": 88
      }
    },
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/",
      "<rootDir>/migrations/"
    ],
    "moduleNameMapper": {
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@app/contracts(|/.*)$": "<rootDir>/libs/contracts/src/$1",
      "^@app/utils(|/.*)$": "<rootDir>/libs/utils/src/$1",
      "^@app/databases(|/.*)$": "<rootDir>/libs/databases/src/$1"
    }
  }
}
