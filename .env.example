# =========================================================
# APSARA TALENT API — .env.example
# Template. Copy to a real env file and fill values. No secrets here.
# =========================================================

# ---------------------------------------------------------
# NODE ENVIRONMENT
# ---------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------
# DATABASE
# ---------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/apsara_talent
# true in dev only; keep false in production
DATABASE_SYNCHRONIZE=false

# ---------------------------------------------------------
# JWT
# ---------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
JWT_EMAIL_EXPIRES=15m
# Window to enter a 2FA code after the password step (defaults to 5m)
JWT_TWO_FACTOR_CHALLENGE_EXPIRES=5m

# ---------------------------------------------------------
# SESSION
# ---------------------------------------------------------
# Required in production — the gateway refuses to start without it.
SESSION_SECRET=replace-with-a-different-long-random-secret

# Swagger at /docs is served automatically outside production. Set to 'true' to
# expose it on a production instance (it maps every route and DTO — leave unset).
ENABLE_SWAGGER=

# ---------------------------------------------------------
# EMAIL (SMTP)
# ---------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=587
EMAIL_USER=development@example.com
EMAIL_PASSWORD=replace-me
EMAIL_FROM=Apsara Talent <development@example.com>

# ---------------------------------------------------------
# RATE LIMITING / THROTTLER
# ---------------------------------------------------------
# Window length in MILLISECONDS. @nestjs/throttler v5+ expects ms — the older
# THROTTLE_TTL was written in seconds, which produced a 60ms window and no
# effective rate limiting. THROTTLE_TTL is still read (and treated as seconds)
# for backwards compatibility; prefer this one.
THROTTLE_TTL_MS=60000

# Requests per window for credential routes: login, OTP, password reset,
# token refresh, email verification. Keep this tight.
THROTTLE_LIMIT=5

# Requests per window for every other route, enforced globally at the gateway.
# High enough that ordinary browsing never trips it.
THROTTLE_GLOBAL_LIMIT=300

# ---------------------------------------------------------
# SMS (TWILIO)
# ---------------------------------------------------------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ---------------------------------------------------------
# MICROSERVICES (PORTS & HOSTS)
# ---------------------------------------------------------
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
AUTH_SERVICE_HOST=127.0.0.1
USER_SERVICE_PORT=3002
USER_SERVICE_HOST=127.0.0.1
RESUME_SERVICE_PORT=3003
RESUME_SERVICE_HOST=127.0.0.1
CHAT_SERVICE_PORT=3004
CHAT_SERVICE_HOST=127.0.0.1
JOB_SERVICE_PORT=3005
JOB_SERVICE_HOST=127.0.0.1
NOTIFICATION_SERVICE_PORT=3007
NOTIFICATION_SERVICE_HOST=127.0.0.1

# ---------------------------------------------------------
# REDIS
# ---------------------------------------------------------
REDIS_WEBSOCKET_HOST=127.0.0.1
REDIS_WEBSOCKET_PORT=6379
REDIS_CACHING_HOST=127.0.0.1
REDIS_CACHING_PORT=6379
# REDIS_CACHING_PASSWORD=
# REDIS_CACHING_USER=
REDIS_CACHING_TLS=false
REDIS_CACHING_TTL=300

# ---------------------------------------------------------
# FRONTEND
# ---------------------------------------------------------
# comma-separated origins or wildcard domains allowed
FRONTEND_ORIGIN=http://127.0.0.1:4000

# ---------------------------------------------------------
# SOCIAL AUTH
# ---------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_CALLBACK_URL=
# LINKEDIN_PROFILE_URL=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# FACEBOOK_CALLBACK_URL=

# ---------------------------------------------------------
# BASE URL
# ---------------------------------------------------------
BASE_URL=http://127.0.0.1:3000

# ---------------------------------------------------------
# OPENAI
# ---------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_MODEL=

# ---------------------------------------------------------
# AI USAGE LIMITS (per authenticated user)
# ---------------------------------------------------------
AI_RATE_LIMIT=10
AI_RATE_LIMIT_WINDOW_MS=60000
AI_DAILY_QUOTA=100
# Per-action daily cap, on top of AI_DAILY_QUOTA. Defaults to 3.
AI_CV_DAILY_QUOTA=3

# ---------------------------------------------------------
# FIREBASE (PUSH NOTIFICATIONS)
# ---------------------------------------------------------
# base64-encoded service-account JSON
# FIREBASE_SERVICE_ACCOUNT=


# ---------------------------------------------------------
# SENTRY (ERROR MONITORING)
# ---------------------------------------------------------
# blank disables Sentry
SENTRY_DSN=
# 0-1; keep low in production
SENTRY_TRACES_SAMPLE_RATE=0.1
# development | staging | production — matches the web app's vocabulary.
# Falls back to NODE_ENV when unset, which is "local" and breaks filtering.
SENTRY_ENVIRONMENT=development
# local tag only; Railway sets RAILWAY_SERVICE_NAME
SENTRY_SERVICE=

# Source map upload (npm run sentry:sourcemaps). Without these, production
# stack traces point at compiled dist/ lines instead of your TypeScript.
SENTRY_ORG=
SENTRY_PROJECT=
# REAL CREDENTIAL — never commit. Set in CI / the deployment secret store.
SENTRY_AUTH_TOKEN=

# ---------------------------------------------------------
# METRICS (PROMETHEUS)
# ---------------------------------------------------------
# optional bearer token protecting /metrics
METRICS_TOKEN=

# ---------------------------------------------------------
# FILE STORAGE
# ---------------------------------------------------------
# 'local' keeps uploads on the container filesystem (./storage). On Railway this
# requires a Volume mounted at /app/storage, and that volume has NO backup.
# 's3' targets any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2,
# MinIO) and is the recommended production setting.
STORAGE_DRIVER=local

# Required when STORAGE_DRIVER=s3 (the app refuses to boot without them).
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Custom endpoint for non-AWS providers. Leave blank for AWS S3.
#   Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com  (S3_REGION=auto)
#   MinIO:         http://127.0.0.1:9000                          (S3_FORCE_PATH_STYLE=true)
# S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Public base URL (CDN or R2 public bucket domain) for world-readable files:
# avatars, company images, resume-template previews. If unset, those fall back
# to presigned URLs — functional, but not cacheable.
# S3_PUBLIC_BASE_URL=

# Lifetime of presigned URLs for private files (resumes, cover letters, chat
# attachments). Seconds; 60-604800.
S3_SIGNED_URL_EXPIRY_SECONDS=900