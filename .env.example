# ==============================================
# APSARA TALENT PLATFORM - ENVIRONMENT TEMPLATE
# ==============================================

# --------------------
# NODE ENVIRONMENT
# --------------------
NODE_ENV=example

# --------------------
# DATABASE CONFIG
# --------------------
DATABASE_URL=
DATABASE_SYNCHRONIZE=false

# --------------------
# JWT CONFIG
# --------------------
JWT_SECRET=
JWT_EXPIRES=1d
JWT_REFRESH_EXPIRES=7d
JWT_EMAIL_EXPIRES=24h

# --------------------
# SESSION CONFIG
# --------------------
SESSION_SECRET=

# --------------------
# EMAIL (SMTP)
# --------------------
SMTP_HOST=
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# --------------------
# RATE LIMIT / THROTTLER
# --------------------
THROTTLE_TTL=60
THROTTLE_LIMIT=5

# --------------------
# SMS (TWILIO)
# --------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --------------------
# MICROSERVICES
# --------------------
API_GATEWAY_PORT=3000

AUTH_SERVICE_HOST=localhost
AUTH_SERVICE_PORT=3001

USER_SERVICE_HOST=localhost
USER_SERVICE_PORT=3002

RESUME_SERVICE_HOST=localhost
RESUME_SERVICE_PORT=3003

CHAT_SERVICE_HOST=localhost
CHAT_SERVICE_PORT=3004

JOB_SERVICE_HOST=localhost
JOB_SERVICE_PORT=3005

PAYMENT_SERVICE_HOST=localhost
PAYMENT_SERVICE_PORT=3006

NOTIFICATION_SERVICE_HOST=localhost
NOTIFICATION_SERVICE_PORT=3007

# --------------------
# REDIS
# --------------------
REDIS_WEBSOCKET_HOST=localhost
REDIS_WEBSOCKET_PORT=6379

REDIS_CACHING_HOST=
REDIS_CACHING_PORT=
REDIS_CACHING_USER=
REDIS_CACHING_PASSWORD=
REDIS_CACHING_TLS=false
REDIS_CACHING_TTL=300

# --------------------
# FRONTEND
# --------------------
FRONTEND_ORIGIN=http://localhost:4000

# --------------------
# SOCIAL AUTH
# --------------------

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=
LINKEDIN_PROFILE_URL=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# Facebook OAuth
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=

# --------------------
# BASE URL
# --------------------
BASE_URL=http://localhost:3000

# --------------------
# OPENAI
# --------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --------------------
# AI USAGE LIMITS (per authenticated user) — protects OpenAI spend
# --------------------
# Max AI requests allowed within AI_RATE_LIMIT_WINDOW_MS (burst protection)
AI_RATE_LIMIT=10
AI_RATE_LIMIT_WINDOW_MS=60000
# Max AI requests per user per calendar day (daily spend cap)
AI_DAILY_QUOTA=100

# --------------------
# ERROR MONITORING (SENTRY) — leave blank to disable
# --------------------
# One DSN shared by the gateway and every microservice (each process inits its
# own client). On Railway, RAILWAY_SERVICE_NAME auto-tags events per service.
SENTRY_DSN=
# Fraction of transactions traced for performance (0.0–1.0)
SENTRY_TRACES_SAMPLE_RATE=0.1

# --------------------
# METRICS (PROMETHEUS / GRAFANA)
# --------------------
# Each service exposes GET /metrics. The gateway serves it on its HTTP port;
# every microservice serves it on its own metrics port (defaults below, used
# by monitoring/prometheus.yml). Override only if the defaults clash.
# AUTH_SERVICE_METRICS_PORT=9101
# USER_SERVICE_METRICS_PORT=9102
# RESUME_SERVICE_METRICS_PORT=9103
# CHAT_SERVICE_METRICS_PORT=9104
# JOB_SERVICE_METRICS_PORT=9105
# PAYMENT_SERVICE_METRICS_PORT=9106
# NOTIFICATION_SERVICE_METRICS_PORT=9107
# Optional: when set, /metrics requires `Authorization: Bearer <token>`.
# Leave blank to keep /metrics open (fine for a private network / dev).
METRICS_TOKEN=

# --------------------
# FIREBASE (PUSH NOTIFICATIONS)
# --------------------
FIREBASE_SERVICE_ACCOUNT=

# --------------------
# BAKONG KHQR PAYMENT
# --------------------
BAKONG_DEVELOPER_TOKEN=
BAKONG_API_BASE_URL=https://api-bakong.nbc.gov.kh
BAKONG_API_TIMEOUT=30000

BAKONG_RATE_LIMIT_REQUESTS=100
BAKONG_RATE_LIMIT_WINDOW_MS=60000

BAKONG_QR_IMAGE_DEFAULT_WIDTH=300
BAKONG_QR_IMAGE_MAX_WIDTH=1000

BAKONG_QR_EXPIRATION_MAX_MINUTES=10080

BAKONG_BULK_PAYMENT_MAX_HASHES=50
