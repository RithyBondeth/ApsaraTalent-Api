# =========================================================
# APSARA TALENT API — .env.example
# Template. Copy to a real env file and fill values. No secrets here.
# =========================================================

# ---------------------------------------------------------
# NODE ENVIRONMENT
# ---------------------------------------------------------
NODE_ENV=

# ---------------------------------------------------------
# DATABASE
# ---------------------------------------------------------
DATABASE_URL=
# true in dev only; keep false in production
DATABASE_SYNCHRONIZE=false

# ---------------------------------------------------------
# JWT
# ---------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES=
JWT_REFRESH_EXPIRES=
JWT_EMAIL_EXPIRES=

# ---------------------------------------------------------
# SESSION
# ---------------------------------------------------------
SESSION_SECRET=

# ---------------------------------------------------------
# EMAIL (SMTP)
# ---------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# ---------------------------------------------------------
# RATE LIMITING / THROTTLER
# ---------------------------------------------------------
THROTTLE_TTL=
THROTTLE_LIMIT=

# ---------------------------------------------------------
# SMS (TWILIO)
# ---------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---------------------------------------------------------
# MICROSERVICES (PORTS & HOSTS)
# ---------------------------------------------------------
API_GATEWAY_PORT=
AUTH_SERVICE_PORT=
AUTH_SERVICE_HOST=
USER_SERVICE_PORT=
USER_SERVICE_HOST=
RESUME_SERVICE_PORT=
RESUME_SERVICE_HOST=
CHAT_SERVICE_PORT=
CHAT_SERVICE_HOST=
JOB_SERVICE_PORT=
JOB_SERVICE_HOST=
PAYMENT_SERVICE_PORT=
PAYMENT_SERVICE_HOST=
NOTIFICATION_SERVICE_PORT=
NOTIFICATION_SERVICE_HOST=

# ---------------------------------------------------------
# REDIS
# ---------------------------------------------------------
REDIS_WEBSOCKET_HOST=
REDIS_WEBSOCKET_PORT=
REDIS_CACHING_HOST=
REDIS_CACHING_PORT=
REDIS_CACHING_PASSWORD=
REDIS_CACHING_USER=
REDIS_CACHING_TLS=
REDIS_CACHING_TTL=

# ---------------------------------------------------------
# FRONTEND
# ---------------------------------------------------------
# comma-separated origins or wildcard domains allowed
FRONTEND_ORIGIN=

# ---------------------------------------------------------
# SOCIAL AUTH
# ---------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=
LINKEDIN_PROFILE_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=

# ---------------------------------------------------------
# BASE URL
# ---------------------------------------------------------
BASE_URL=

# ---------------------------------------------------------
# OPENAI
# ---------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=

# ---------------------------------------------------------
# AI USAGE LIMITS (per authenticated user)
# ---------------------------------------------------------
AI_RATE_LIMIT=
AI_RATE_LIMIT_WINDOW_MS=
AI_DAILY_QUOTA=

# ---------------------------------------------------------
# FIREBASE (PUSH NOTIFICATIONS)
# ---------------------------------------------------------
# base64-encoded service-account JSON
FIREBASE_SERVICE_ACCOUNT=

# ---------------------------------------------------------
# BAKONG KHQR PAYMENT
# ---------------------------------------------------------
BAKONG_DEVELOPER_TOKEN=
BAKONG_API_BASE_URL=
BAKONG_API_TIMEOUT=
BAKONG_RATE_LIMIT_REQUESTS=
BAKONG_RATE_LIMIT_WINDOW_MS=
BAKONG_QR_IMAGE_DEFAULT_WIDTH=
BAKONG_QR_IMAGE_MAX_WIDTH=
# max 1 year (525600)
BAKONG_QR_EXPIRATION_MAX_MINUTES=
BAKONG_BULK_PAYMENT_MAX_HASHES=

# ---------------------------------------------------------
# SENTRY (ERROR MONITORING)
# ---------------------------------------------------------
# blank disables Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=
# local tag only; Railway sets RAILWAY_SERVICE_NAME
SENTRY_SERVICE=

# ---------------------------------------------------------
# METRICS (PROMETHEUS)
# ---------------------------------------------------------
# optional bearer token protecting /metrics
METRICS_TOKEN=
