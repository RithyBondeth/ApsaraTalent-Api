{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../..",
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "testEnvironment": "node",
  "testTimeout": 30000,
  "maxWorkers": 1,
  "moduleNameMapper": {
    "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1",
    "^@app/contracts(|/.*)$": "<rootDir>/libs/contracts/src/$1",
    "^@app/utils(|/.*)$": "<rootDir>/libs/utils/src/$1"
  }
}
