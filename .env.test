# =========================================================
# APSARA TALENT API — .env.test
# Safe, non-production defaults used by unit tests and CI only.
# No real credentials belong here: this file IS tracked, and the secret scan
# in deploy.yml allows it by name precisely because it must never hold one.
#
# The isolated end-to-end stack does NOT read this file — it has its own
# test/e2e/e2e.env alongside test/e2e/docker-compose.e2e.yml.
# =========================================================

# ---------------------------------------------------------
# NODE ENVIRONMENT
# ---------------------------------------------------------
NODE_ENV=test

# ---------------------------------------------------------
# DATABASE
# ---------------------------------------------------------
# Unit tests never open a connection — the QueryRunner is mocked. This exists
# so the Joi schema in libs/common/src/config/validation.schema.ts passes.
DATABASE_URL=postgresql://test:test@127.0.0.1:5432/apsara_talent_test
DATABASE_SYNCHRONIZE=false

# ---------------------------------------------------------
# JWT
# ---------------------------------------------------------
JWT_SECRET=test-jwt-secret-not-for-production
JWT_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_EMAIL_EXPIRES=1h

# ---------------------------------------------------------
# SESSION
# ---------------------------------------------------------
SESSION_SECRET=test-session-secret-not-for-production

# ---------------------------------------------------------
# EMAIL (SMTP)
# ---------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=2525
EMAIL_USER=test@example.com
EMAIL_PASSWORD=test-password
EMAIL_FROM=test@example.com

# ---------------------------------------------------------
# RATE LIMITING / THROTTLER
# ---------------------------------------------------------
# NOTE: this is the legacy THROTTLE_TTL, read in SECONDS. Production and
# .env.example use THROTTLE_TTL_MS instead. Left as-is deliberately: it keeps
# the backwards-compatible path exercised by the test suite.
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
