# Safe, non-production defaults used by unit tests and CI only.
NODE_ENV=test
DATABASE_URL=postgresql://test:test@127.0.0.1:5432/apsara_talent_test
DATABASE_SYNCHRONIZE=false

JWT_SECRET=test-jwt-secret-not-for-production
JWT_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
JWT_EMAIL_EXPIRES=1h
SESSION_SECRET=test-session-secret-not-for-production

SMTP_HOST=localhost
SMTP_PORT=2525
EMAIL_USER=test@example.com
EMAIL_PASSWORD=test-password
EMAIL_FROM=test@example.com

THROTTLE_TTL=60000
THROTTLE_LIMIT=100